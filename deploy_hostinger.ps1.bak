# Script de Deploy Automatizado para Hostinger - Losfit.com.br
# ATENÇÃO: Contém credenciais sensíveis. Não comitar este arquivo.

$serverIp = "185.245.180.69"
$port = "65002"
$user = "u488238372"
$pass = "!Sa002125"
$remotePath = "/home/$user/public_html"
$projectPath = Get-Location
$tempDir = Join-Path $projectPath "temp_deploy_hostinger"

# Configuração de Cores
function Write-Color($text, $color) { Write-Host $text -ForegroundColor $color }

Write-Color "=== INICIANDO DEPLOY PARA HOSTINGER ===" Cyan

# 1. Preparação (Limpeza e Build Local)
Write-Color "`n1. Preparando arquivos..." Yellow

# Limpa diretório temp antigo
if (Test-Path $tempDir) { Remove-Item -Path $tempDir -Recurse -Force -ErrorAction SilentlyContinue }
New-Item -ItemType Directory -Path $tempDir -Force | Out-Null

# Copia arquivos do projeto
Write-Color "   Copiando arquivos do projeto..." Gray
Copy-Item -Path "$projectPath\*" -Destination $tempDir -Recurse -Force -ErrorAction SilentlyContinue

# Remove arquivos desnecessários
Write-Color "   Removendo arquivos de desenvolvimento..." Gray
$excludeItems = @(
    ".git", ".github", ".idea", ".vscode", "node_modules", "tests", 
    "storage/*.key", "*.log", ".env", ".env.*", "deploy_*.ps1", "*.zip", "*.tar.gz"
)
foreach ($item in $excludeItems) {
    if ($item -like "*/*") {
        # Tratamento simples para caminhos com wildcards se necessário, ou apenas ignorar erros
        Remove-Item -Path "$tempDir\$item" -Recurse -Force -ErrorAction SilentlyContinue
    }
    else {
        Remove-Item -Path "$tempDir\$item" -Recurse -Force -ErrorAction SilentlyContinue
    }
}

# 2. Configuração de Produção
Write-Color "`n2. Configurando ambiente de produção..." Yellow

# Copia .env.production.example para .env (será ajustado no servidor se necessário, mas idealmente já enviamos o correto ou mantemos o do servidor)
# Na verdade, a estratégia mais segura é NÃO sobrescrever o .env do servidor se ele já existir.
# Vamos criar um .env.deploy apenas para garantir
Copy-Item -Path "$projectPath\.env.production.example" -Destination "$tempDir\.env.example"

# Copia o .htaccess de produção
if (Test-Path "$projectPath\public\.htaccess_production") {
    Copy-Item -Path "$projectPath\public\.htaccess_production" -Destination "$tempDir\public\.htaccess" -Force
}

# 3. Build de Assets (Opcional se já feito, mas garantindo)
# Como node_modules foi removido da cópia, assumimos que o build foi feito ANTES ou não enviamos node_modules.
# O plano dizia: "Instala dependências... npm install && npm run build". 
# Mas fazer isso no tempDir iria demorar e exigir baixar tudo de novo.
# Melhor fazer o build na raiz e copiar os assets compilados (public/build).
# O Copy-Item inicial já copiou public/build se ele existia.

# 4. Upload via SCP
Write-Color "`n3. Enviando arquivos para o servidor (isso pode demorar)..." Cyan

# Requer OpenSSH Client instalado no Windows
# Vamos usar scp recursivo. Para evitar pedir senha, o ideal seria chave SSH.
# Mas como temos senha, podemos usar sshpass se disponível, ou o usuário terá que digitar.
# NOTA: O Windows nativamente não tem sshpass. O usuário terá que digitar a senha se não tiver chave configurada.
# Alternativa: Usar WinSCP via script se instalado, mas vamos tentar scp nativo primeiro.

Write-Color "   ATENÇÃO: Você pode precisar digitar a senha ($pass) várias vezes se não tiver chave SSH configurada." Magenta

# Zipando para upload mais rápido (um único arquivo)
$zipFile = "$projectPath\deploy_package.zip"
Write-Color "   Compactando arquivos para upload..." Gray
Compress-Archive -Path "$tempDir\*" -DestinationPath $zipFile -Force

Write-Color "   Enviando pacote zip..." Cyan
scp -P $port "$zipFile" "$user@${serverIp}:$remotePath/deploy_package.zip"

if ($LASTEXITCODE -ne 0) {
    Write-Color "   ERRO no upload. Verifique as credenciais." Red
    exit
}

# 5. Comandos Remotos
Write-Color "`n4. Executando comandos no servidor..." Yellow

$commands = @"
cd $remotePath
unzip -o deploy_package.zip
rm deploy_package.zip

# Verifica .env
if [ ! -f .env ]; then
    cp .env.example .env
    echo 'CRIADO NOVO .ENV - CONFIGURE-O!'
fi

# Instala dependências PHP (Composer)
# Isso assume que o composer está no path ou php composer.phar
# No Hostinger as vezes é /usr/bin/composer
composer install --no-dev --optimize-autoloader

# Permissões
chmod -R 775 storage bootstrap/cache

# Caches
php artisan config:cache
php artisan route:cache
php artisan view:cache
php artisan storage:link

echo 'DEPLOY CONCLUIDO'
"@

# Executa comandos via SSH
ssh -p $port "$user@$serverIp" $commands

# Limpeza local
Write-Color "`n5. Limpeza..." Yellow
Remove-Item -Path $tempDir -Recurse -Force -ErrorAction SilentlyContinue
Remove-Item -Path $zipFile -Force -ErrorAction SilentlyContinue

Write-Color "`n=== DEPLOY FINALIZADO ===" Green
